#!/bin/sh
#
# Infinity FC305 H7 board sensor initialization
#-------------------------------------------------------------------------------

board_adc start

# Internal ICM42688P on SPI1. TIM1_CH1 supplies a 32.051 kHz CLKIN.
# The sensor axes are already aligned with the PX4 body frame (rotation 0).
icm42688p -s -b 1 -R 0 -C 32051 start

# Internal BMP390 on I2C2 (address 0x76 / 118). The BMP388 driver supports
# BMP390 as well.
bmp388 -X -b 2 -a 0x76 start

# There is no onboard magnetometer. The external GPS/compass connector shares
# I2C2 with the barometer; start the driver matching the fitted compass.
