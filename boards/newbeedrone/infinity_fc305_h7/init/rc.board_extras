#!/bin/sh
#
# Infinity FC305 H7 board extras
#-------------------------------------------------------------------------------

# AT7456E analog OSD on SPI3. Set OSD_ATXXXX_CFG to 1 (NTSC) or 2 (PAL).
if ! param compare OSD_ATXXXX_CFG 0
then
	atxxxx start -s
fi

# DShot ESC serial telemetry on the ESC1 UART5 return line.
# UART3 is wired to the ESC2 telemetry return, but the common PX4 DShot driver
# supports one serial telemetry UART. Keep ESC2 available as TEL2 without
# opening it here. This is separate from bidirectional DShot telemetry on the
# motor signal pins.
dshot telemetry -d /dev/ttyS4
